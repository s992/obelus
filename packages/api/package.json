{
  "name": "@obelus/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/appRouter.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "NODE_ENV=production tsup",
    "gql:gen": "graphql-codegen",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "sql:gen": "dotenvx run -f ../../.env -- sqlc generate && pnpm sql:fix",
    "sql:fix": "tsx codemod/fix-sqlc.ts",
    "sql:migrate": "tsx ./src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/jwt": "catalog:",
    "@fastify/multipart": "catalog:",
    "@obelus/shared": "workspace:*",
    "@trpc/server": "catalog:",
    "argon2": "catalog:",
    "bullmq": "catalog:",
    "csv-parse": "catalog:",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@types/pg": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:"
  }
}
